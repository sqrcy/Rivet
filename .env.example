# Roblox Open Cloud key with access to the dedicated Rivet test universe/place.
ROBLOX_API_KEY=

# Dedicated disposable test target. The cloud test script uploads to this place.
RIVET_TEST_UNIVERSE_ID=
RIVET_TEST_PLACE_ID=

# Optional polling controls.
RIVET_CLOUD_TEST_TIMEOUT=300
RIVET_CLOUD_TEST_POLL_INTERVAL=2

# Optional upload retry controls for transient Roblox 409 conflicts.
RIVET_CLOUD_TEST_UPLOAD_RETRIES=3
RIVET_CLOUD_TEST_RETRY_DELAY=120

# Optional benchmark target. If these are blank, scripts/benchmark-cloud.sh
# falls back to RIVET_TEST_UNIVERSE_ID and RIVET_TEST_PLACE_ID.
RIVET_BENCHMARK_UNIVERSE_ID=
RIVET_BENCHMARK_PLACE_ID=

# Optional benchmark run controls.
RIVET_BENCHMARK_TIMEOUT=300
RIVET_BENCHMARK_POLL_INTERVAL=2
RIVET_BENCHMARK_UPLOAD_RETRIES=3
RIVET_BENCHMARK_RETRY_DELAY=120
RIVET_BENCHMARK_SAMPLES=7
RIVET_BENCHMARK_WARMUPS=50
RIVET_BENCHMARK_ITERATIONS=1000
RIVET_BENCHMARK_BOOT_ITERATIONS=50
RIVET_BENCHMARK_CLEANUP_ITERATIONS=100
RIVET_BENCHMARK_CLEANUP_TASKS=1000
RIVET_BENCHMARK_CODEC_ITERATIONS=250
RIVET_BENCHMARK_COMPLEX_ITERATIONS=100
RIVET_BENCHMARK_COMPLEX_SIZE=40
